# Shared local development defaults.
# Copy to ".env" at the repo root for: api-node, api-python, docker compose.
# The web and mobile apps load env from their own dirs:
#   - apps/web/.env.local       (see apps/web/.env.local.example)
#   - apps/mobile/.env          (see apps/mobile/.env.example)
NODE_ENV=development

# Public API URLs consumed by the web and mobile apps.
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# api-node
NODE_API_PORT=4000
FLASK_API_URL=http://localhost:5000
DATABASE_URL=mysql://app:app_password@localhost:3306/app_db
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Novu (leave empty to disable; api-node will report novu: missing in /health and skip triggers).
NOVU_SECRET_KEY=

# Keycloak (api-node verifies bearer tokens against this issuer/audience).
KEYCLOAK_ISSUER=http://localhost:8080/realms/fullstack
KEYCLOAK_AUDIENCE=fullstack-api

# api-python
FLASK_PORT=5000

# docker compose
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=app_db
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Comma-separated origins allowed to PUT to MinIO via presigned URLs.
MINIO_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
