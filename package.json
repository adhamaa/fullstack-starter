{
  "name": "fullstack-starter",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 turbo dev --parallel",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:frontend": "cross-env NODE_OPTIONS=--max-old-space-size=4096 turbo dev --parallel --filter=web --filter=mobile",
    "dev:api-node": "pnpm --filter api-node dev",
    "dev:api-python": "pnpm --filter api-python dev",
    "dev:backend": "turbo dev --parallel --filter=api-node --filter=api-python",
    "dev:keycloak-theme": "pnpm --filter @fullstack/keycloak-theme dev",
    "storybook:keycloak-theme": "pnpm --filter @fullstack/keycloak-theme storybook",
    "build": "turbo build",
    "build:keycloak-theme": "pnpm --filter @fullstack/keycloak-theme build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "biome format --write .",
    "check": "biome check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "cross-env": "^7.0.3",
    "turbo": "latest",
    "typescript": "latest"
  }
}
