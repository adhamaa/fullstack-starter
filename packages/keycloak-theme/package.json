    "lucide-react": "^0.473.0",
    "radix-ui": "latest",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^15.7.4",
    "react-icons": "^5.6.0",
    "rfc4648": "^1.5.4",
    "tailwind-merge": "^2.6.0",
    "tsafe": "^1.8.5",
    "tw-animate-css": "^1.4.0"
  },
