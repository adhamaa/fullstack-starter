{
  "name": "@fullstack/keycloak-theme",
  "private": true,
  "version": "0.0.0",
  "description": "Keycloak 26 theme(s) built with Keycloakify + shadcn/ui",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "tsc -p tsconfig.app.json && vite build",
    "build:kc": "node ./scripts/run-build-kc.mjs",
    "build:themes": "node ./scripts/run-build-themes.mjs",
    "build": "pnpm run build:themes",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "emails:preview": "email preview ./src/email/templates",
    "lint": "biome check src scripts vite.config.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "license": "MIT",
  "keywords": [],
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/geist": "^5.2.8",
