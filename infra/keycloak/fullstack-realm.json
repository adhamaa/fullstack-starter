{
  "realm": "fullstack",
  "enabled": true,
  "clients": [
    {
      "clientId": "fullstack-api",
      "name": "Fullstack API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true
    },
    {
      "clientId": "fullstack-web",
      "name": "Fullstack Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "fullstack-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    },
    {
      "clientId": "fullstack-mobile",
      "name": "Fullstack Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["fullstackstarter://*", "exp://*"],
      "webOrigins": ["*"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "admin" }
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ],
      "realmRoles": ["user"]
    }
  ]
}
