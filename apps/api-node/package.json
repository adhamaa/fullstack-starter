    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@fullstack/types": "workspace:*",
    "@novu/node": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "ioredis": "latest",
    "jose": "latest",
    "mysql2": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
