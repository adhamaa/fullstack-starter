{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "jsxImportSource": "nativewind",
    "baseUrl": ".",
    "paths": {
      "@fullstack/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@fullstack/types": [
        "../../packages/types/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
