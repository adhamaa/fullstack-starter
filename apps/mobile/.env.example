# Copy to apps/mobile/.env for local development.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Keycloak realm + native client (must match infra/keycloak/fullstack-realm.json).
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/fullstack
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=fullstack-mobile

# Expo web uses http://localhost:8081 (not fullstackstarter://). That URI must be allowed
# on the fullstack-mobile client in Keycloak — see infra/keycloak/fullstack-realm.json.
# EXPO_PUBLIC_APP_REDIRECT_URI=http://localhost:8081
