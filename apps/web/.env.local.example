# Copy to apps/web/.env.local for local development.
# AUTH_SECRET is required by NextAuth v5 (`openssl rand -base64 32`).
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Public URL of the Next.js app (used by NextAuth for callback URLs).
NEXTAUTH_URL=http://localhost:3000

# Keycloak realm + web client (must match infra/keycloak/fullstack-realm.json).
KEYCLOAK_ISSUER=http://localhost:8080/realms/fullstack
KEYCLOAK_CLIENT_ID=fullstack-web
KEYCLOAK_CLIENT_SECRET=fullstack-web-dev-secret

# Public URL the browser uses to reach the Node API.
NEXT_PUBLIC_API_URL=http://localhost:4000
